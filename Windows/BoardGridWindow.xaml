
<Window x:Class="ChessAssistant.Windows.BoardGridWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Chessboard Grid Detection"
        Width="860"
        Height="900"
        WindowStartupLocation="CenterScreen"
        Background="#111827">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="CHESSBOARD GRID DETECTION"
                   Foreground="White"
                   FontSize="20"
                   FontWeight="Bold"
                   Margin="0,0,0,15"/>

        <Border Grid.Row="1"
                Background="#000000"
                BorderBrush="#374151"
                BorderThickness="1"
                HorizontalAlignment="Center"
                VerticalAlignment="Center">

            <Grid Width="800" Height="800">
                <Image x:Name="BoardImage"
                       Stretch="Fill"/>

                <Canvas x:Name="GridCanvas"
                        Width="800"
                        Height="800"
                        IsHitTestVisible="False"/>
            </Grid>
        </Border>

        <TextBlock Grid.Row="2"
                   Text="8 columns × 8 rows = 64 squares"
                   Foreground="#22C55E"
                   FontSize="16"
                   FontWeight="Bold"
                   HorizontalAlignment="Center"
                   Margin="0,15,0,0"/>
    </Grid>
</Window>
