
<Window x:Class="ChessAssistant.Windows.BoardCalibrationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Manual Chessboard Calibration"
        WindowState="Maximized"
        WindowStartupLocation="CenterScreen"
        Background="#111827">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Margin="0,0,0,15">
            <TextBlock Text="MANUAL BOARD CALIBRATION"
                       Foreground="White"
                       FontSize="20"
                       FontWeight="Bold"/>

            <TextBlock Text="Drag the four green markers onto the four outer corners of your chessboard."
                       Foreground="#D1D5DB"
                       FontSize="13"
                       Margin="0,8,0,0"/>
        </StackPanel>

        <Border Grid.Row="1"
                Background="Black"
                BorderBrush="#374151"
                BorderThickness="1"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch">

            <Viewbox Stretch="Uniform"
                     MaxWidth="800"
                     MaxHeight="800">
                <Grid Width="800" Height="800">
                    <Image x:Name="BoardImage"
                           Stretch="Fill"/>

                    <Canvas x:Name="CalibrationCanvas"
                            Width="800"
                            Height="800"
                            Background="Transparent"
                            MouseLeftButtonDown="Canvas_MouseLeftButtonDown"
                            MouseMove="Canvas_MouseMove"
                            MouseLeftButtonUp="Canvas_MouseLeftButtonUp"/>
                </Grid>
            </Viewbox>
        </Border>

        <StackPanel Grid.Row="2"
                    Orientation="Horizontal"
                    HorizontalAlignment="Center"
                    Margin="0,15,0,0">

            <Button Content="Save Calibration"
                    Width="180"
                    Height="42"
                    Margin="5"
                    Background="#16A34A"
                    Foreground="White"
                    FontWeight="Bold"
                    BorderThickness="0"
                    Click="SaveCalibration_Click"/>

            <Button Content="Cancel"
                    Width="120"
                    Height="42"
                    Margin="5"
                    Background="#475569"
                    Foreground="White"
                    BorderThickness="0"
                    Click="Cancel_Click"/>
        </StackPanel>
    </Grid>
</Window>
