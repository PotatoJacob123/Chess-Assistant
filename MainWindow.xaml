<Window x:Class="ChessAssistant.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Chess Assistant"
        Height="720"
        Width="440"
        MinHeight="520"
        MinWidth="360"
        WindowStartupLocation="CenterScreen"
        Background="#0B1220"
        Foreground="White">

    <Window.Resources>
        <Style x:Key="ActionButton" TargetType="Button">
            <Setter Property="Height" Value="42"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
        </Style>

        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#94A3B8"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
        </Style>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock Text="♟ CHESS ASSISTANT"
                       FontSize="23"
                       FontWeight="Bold"/>
            <TextBlock Text="Your personal chess analysis companion"
                       Foreground="#94A3B8"
                       Margin="0,4,0,0"/>
        </StackPanel>

        <ScrollViewer Grid.Row="1"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      CanContentScroll="True">
            <StackPanel>
                <Border Background="#172235" CornerRadius="12" Padding="16" Margin="0,0,0,14">
                    <StackPanel>
                        <TextBlock Text="BOARD CAPTURE" Style="{StaticResource SectionTitle}"/>
                        <TextBlock x:Name="BoardStatus"
                                   Text="No board selected"
                                   FontSize="15"
                                   TextWrapping="Wrap"
                                   Foreground="White"
                                   Margin="0,0,0,14"/>

                        <UniformGrid Columns="2">
                            <Button Content="Select Chessboard"
                                    Style="{StaticResource ActionButton}"
                                    Background="#2563EB"
                                    Margin="0,0,6,8"
                                    Click="SelectBoard_Click"/>
                            <Button Content="Recognize Pieces"
                                    Style="{StaticResource ActionButton}"
                                    Background="#7C3AED"
                                    Margin="0,0,6,8"
                                    Click="RecognizePieces_Click"/>
                            <Button Content="Preview Board Crop"
                                    Style="{StaticResource ActionButton}"
                                    Background="#475569"
                                    Margin="6,0,0,8"
                                    Click="PreviewBoardCrop_Click"/>
                        </UniformGrid>

                        <Button Content="Clear Arrow"
                                Style="{StaticResource ActionButton}"
                                Background="#B91C1C"
                                Margin="0,8,0,0"
                                Click="ClearArrow_Click"/>
                    </StackPanel>
                </Border>

                <Border Background="#172235" CornerRadius="12" Padding="16" Margin="0,0,0,14">
            <StackPanel>
                        <TextBlock Text="ENGINE ANALYSIS" Style="{StaticResource SectionTitle}"/>
                        <TextBlock Text="Stockfish"
                                   FontSize="16"
                                   FontWeight="Bold"/>
                        <TextBlock x:Name="EngineStatus"
                                   Text="Not connected"
                                   Foreground="#FBBF24"
                                   TextWrapping="Wrap"
                                   Margin="0,5,0,12"/>
                        <TextBlock x:Name="PositionEvaluation"
                                   Text="Position evaluation: --"
                                   FontSize="15"
                                   FontWeight="SemiBold"
                                   Foreground="#E2E8F0"
                                   TextWrapping="Wrap"
                                   Margin="0,0,0,12"/>

                        <Button Content="Start / Stop Live Analysis"
                                Style="{StaticResource ActionButton}"
                                Background="#16A34A"
                                Height="46"
                                Click="StartAnalysis_Click"/>
                        <Button x:Name="BoardOrientationButton"
                                Content="Board View: White at Bottom"
                                Style="{StaticResource ActionButton}"
                                Background="#7C3AED"
                                Click="FlipBoardOrientation_Click"/>

                        <UniformGrid Columns="2" Margin="0,2,0,0">
                            <Button Content="White to Move"
                                    Style="{StaticResource ActionButton}"
                                    Background="#2563EB"
                                    Margin="0,0,6,0"
                                    Click="WhiteToMove_Click"/>
                            <Button Content="Black to Move"
                                    Style="{StaticResource ActionButton}"
                                    Background="#475569"
                                    Margin="6,0,0,0"
                                    Click="BlackToMove_Click"/>
                        </UniformGrid>
                    </StackPanel>
                </Border>

                <Border Background="#172235" CornerRadius="12" Padding="16" Margin="0,0,0,8">
                    <StackPanel>
                        <TextBlock Text="OVERLAY SETTINGS" Style="{StaticResource SectionTitle}"/>
                        <CheckBox x:Name="OverlayEnabled"
                                  Content="Enable overlay"
                                  IsChecked="True"
                                  Foreground="White"
                                  Margin="0,2,0,14"/>
                        <CheckBox x:Name="AlwaysOnTop"
                                  Content="Always on top"
                                  IsChecked="True"
                                  Foreground="White"
                                  Margin="0,0,0,14"/>
                        <CheckBox x:Name="ShowCoordinates"
                                  Content="Show board coordinates"
                                  IsChecked="True"
                                  Foreground="White"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <TextBlock Grid.Row="2"
                   Text="CHESS ASSISTANT • VERSION 0.1"
                   Foreground="#64748B"
                   FontSize="10"
                   HorizontalAlignment="Center"
                   Margin="0,12,0,0"/>
    </Grid>
</Window>
