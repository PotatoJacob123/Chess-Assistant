
<Window x:Class="ChessAssistant.Windows.RecognitionResultWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Chess Recognition Results"
        Width="750"
        Height="850"
        WindowStartupLocation="CenterScreen"
        Background="#111827">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Margin="0,0,0,15">
            <TextBlock Text="CHESS PIECE RECOGNITION"
                       Foreground="White"
                       FontSize="20"
                       FontWeight="Bold"/>

            <TextBlock x:Name="OrientationText"
                       Foreground="#22C55E"
                       FontSize="14"
                       Margin="0,8,0,0"/>

            <TextBlock x:Name="ConfidenceText"
                       Foreground="#D1D5DB"
                       FontSize="13"
                       Margin="0,4,0,0"/>
        </StackPanel>

        <Border Grid.Row="1"
                BorderBrush="#475569"
                BorderThickness="1"
                HorizontalAlignment="Center"
                VerticalAlignment="Center">

            <UniformGrid x:Name="BoardGrid"
                         Rows="8"
                         Columns="8"
                         Width="640"
                         Height="640"/>
        </Border>

        
        <StackPanel Grid.Row="2" Margin="0,15,0,0">
            <TextBlock Text="FEN SETTINGS"
                    Foreground="White"
                    FontWeight="Bold"/>

            <WrapPanel Margin="0,8,0,8">
                <TextBlock Text="Side to move:"
                        Foreground="White"
                        VerticalAlignment="Center"
                        Margin="0,0,8,0"/>

                <ComboBox x:Name="SideToMoveBox"
                        Width="100"
                        SelectedIndex="0"
                        SelectionChanged="FenSettings_Changed">
                    <ComboBoxItem Content="White"/>
                    <ComboBoxItem Content="Black"/>
                </ComboBox>
            </WrapPanel>

            <TextBlock Text="Castling rights:"
                    Foreground="White"/>

            <WrapPanel Margin="0,5,0,8">
                <CheckBox x:Name="WhiteKingSide"
                        Content="White K"
                        Foreground="White"
                        Margin="5"
                        Checked="FenSettings_Changed"
                        Unchecked="FenSettings_Changed"/>

                <CheckBox x:Name="WhiteQueenSide"
                        Content="White Q"
                        Foreground="White"
                        Margin="5"
                        Checked="FenSettings_Changed"
                        Unchecked="FenSettings_Changed"/>

                <CheckBox x:Name="BlackKingSide"
                        Content="Black k"
                        Foreground="White"
                        Margin="5"
                        Checked="FenSettings_Changed"
                        Unchecked="FenSettings_Changed"/>

                <CheckBox x:Name="BlackQueenSide"
                        Content="Black q"
                        Foreground="White"
                        Margin="5"
                        Checked="FenSettings_Changed"
                        Unchecked="FenSettings_Changed"/>
            </WrapPanel>

            <WrapPanel Margin="0,0,0,8">
                <TextBlock Text="En passant:"
                        Foreground="White"
                        VerticalAlignment="Center"
                        Margin="0,0,8,0"/>

                <TextBox x:Name="EnPassantText"
                        Width="65"
                        Text="-"
                        TextChanged="FenSettings_Changed"/>
            </WrapPanel>

            <WrapPanel Margin="0,0,0,8">
                <TextBlock Text="Halfmove clock:"
                        Foreground="White"
                        VerticalAlignment="Center"/>

                <TextBox x:Name="HalfmoveText"
                        Width="45"
                        Text="0"
                        Margin="8,0,15,0"
                        TextChanged="FenSettings_Changed"/>

                <TextBlock Text="Fullmove number:"
                        Foreground="White"
                        VerticalAlignment="Center"/>

                <TextBox x:Name="FullmoveText"
                        Width="45"
                        Text="1"
                        Margin="8,0,0,0"
                        TextChanged="FenSettings_Changed"/>
            </WrapPanel>

            <TextBlock Text="Generated FEN:"
                    Foreground="White"
                    FontWeight="Bold"/>

            <TextBox x:Name="FenText"
                    IsReadOnly="True"
                    TextWrapping="Wrap"
                    Background="#1F2937"
                    Foreground="#22C55E"
                    BorderBrush="#475569"
                    Padding="8"
                    Margin="0,8,0,0"/>
            <Button Content="Analyze with Stockfish"
                    Height="42"
                    Margin="0,12,0,0"
                    Background="#7C3AED"
                    Foreground="White"
                    FontWeight="Bold"
                    BorderThickness="0"
                    Click="AnalyzeWithStockfish_Click"/>

            <TextBlock x:Name="BestMoveText"
                    Text="No analysis performed yet."
                    Foreground="#22C55E"
                    FontSize="16"
                    FontWeight="Bold"
                    Margin="0,12,0,0"
                    TextWrapping="Wrap"/>
        </StackPanel>

    </Grid>
</Window>
